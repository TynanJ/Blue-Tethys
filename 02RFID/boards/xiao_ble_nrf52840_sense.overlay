&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";

    cs-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;  /* D4 = P0.04 */

    rc522: rc522@0 {
        compatible = "vnd,spi-device";
        reg = <0>;
        spi-max-frequency = <5000000>;
    };
};

&pinctrl {
    spi2_default: spi2_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  1, 13)>,  /* D8  = P1.13 */
                    <NRF_PSEL(SPIM_MOSI, 1, 15)>,  /* D10 = P1.15 */
                    <NRF_PSEL(SPIM_MISO, 1, 14)>;  /* D9  = P1.14 */
        };
    };
    spi2_sleep: spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>;
            low-power-enable;
        };
    };
};

/ {
    rc522_pins {
        compatible = "gpio-leds";
        status = "okay";
        rc522_rst: rc522_rst_0 {
            gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;  /* D3 = P0.29 */
            label = "RC522_RST";
        };
    };
};